{
  "name": "@fuel-feet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fuel-feet/shared": "0.1.0",
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "pino": "^10.3.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.2.0"
  }
}

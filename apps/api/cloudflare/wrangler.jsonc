{
  "name": "fuel-feet-api-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "ratelimits": [{
    "name": "ACCESS_LIMITER",
    "namespace_id": "10401",
    "simple": { "limit": 180, "period": 60 }
  }],
  "vars": {
    "REQUIRE_MFA": "false",
    "WEB_ORIGIN": "https://fuel-feet.vercel.app",
    "SUPABASE_DOCUMENT_BUCKET": "fuel-feet-documents"
  }
}

{
  "name": "fuel-feet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": ">=11.19.1 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently --kill-others --names shared,api,web \"npm run dev -w @fuel-feet/shared\" \"npm run dev -w @fuel-feet/api\" \"npm run dev -w @fuel-feet/web\"",
    "build:shared": "npm run build -w @fuel-feet/shared",
    "build": "npm run build:shared && npm run build -w @fuel-feet/api && npm run build -w @fuel-feet/web",
    "start:api": "npm run start -w @fuel-feet/api",
    "lint": "eslint .",
    "typecheck": "npm run build:shared && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "npm run build:shared && vitest run",
    "test:e2e": "npm run build:shared && playwright test",
    "db:generate": "npm run db:generate -w @fuel-feet/api",
    "db:migrate": "npm run db:migrate -w @fuel-feet/api",
    "test:db": "node --import tsx --test tests/database.integration.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}

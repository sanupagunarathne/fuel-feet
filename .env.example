# Copy to .env in the repository root to override defaults. Keep real
# credentials in ignored local files or managed service settings.

# Web. The Vite development proxy routes /api to the local Express server.
# For separate origins, use the full API base URL, including /api.
VITE_API_BASE_URL=/api

# Express runtime.
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Optional read-only frontend demo. Production builds ignore this flag.
VITE_DEMO_MODE=false

# Supabase Auth. Use the project URL and publishable key on both sides.
# Only public configuration belongs in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# API-only runtime role and separate migration owner.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Server-only credential for the private document bucket.
SUPABASE_STORAGE_KEY=
SUPABASE_DOCUMENT_BUCKET=fuel-feet-documents
# Bounded attachment uploads. Confirm limit before rollout.
DOCUMENT_MAX_BYTES=10485760
